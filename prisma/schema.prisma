generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Zone {
  id       String   @id @default(uuid())
  name     String   // e.g., "Zon 1", "Zon 2"
  mosques  Mosque[]
}

model Mosque {
  id          String   @id @default(uuid())
  name        String   // e.g., "Masjid Jame' Asr Hassanil Bolkiah"
  phoneNumber String?  // e.g., "02-1234567"
  zoneId      String
  zone        Zone     @relation(fields: [zoneId], references: [id])
  users       User[]
}

model User {
  id          String   @id @default(uuid())
  loginId     String   @unique // e.g., "AMIL-Z01-001" or "admin"
  name        String
  password    String
  role        String   // "AMIL" or "ADMIN"
  position    String?  // e.g., "Imam", "Bilal"
  phoneNumber String?  // e.g., "012-3456789"
  mosqueId    String?
  mosque      Mosque?  @relation(fields: [mosqueId], references: [id])
  receipts    Receipt[]
  createdAt   DateTime @default(now())
}

model RiceType {
  id         String   @id @default(uuid())
  code       String   // e.g., "B_SIAM_1447H"
  name       String
  price      Float
  activeYear String   // e.g., "1447H"
  receipts   Receipt[]

  @@unique([name, activeYear])
}

model Receipt {
  id            String   @id @default(cuid())
  receiptNumber String   @unique
  payerName     String
  payerIcNumber String?
  isVerified    Boolean  @default(false)
  imageUrl      String?  
  dependents    Int      @default(0)
  paymentDate   DateTime @default(now())
  totalAmount   Float    @default(0)
  
  amilId        String
  amil          User     @relation(fields: [amilId], references: [id])
  
  riceTypeId    String
  riceType      RiceType @relation(fields: [riceTypeId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
